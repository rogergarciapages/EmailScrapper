{
  "providers": ["python"],
  "nixPkgs": [
    "chromium",
    "stdenv.cc.cc.lib",
    "gcc-unwrapped",
    "zlib"
  ],
  "aptPkgs": [
    "libstdc++6",
    "zlib1g",
    "libgl1"
  ],
  "phases": {
    "install": {
      "cmds": [
        "python -m venv /opt/venv",
        "/opt/venv/bin/pip install -r requirements.txt",
        "/opt/venv/bin/playwright install chromium"
      ]
    }
  },
  "start": {
    "cmd": "/opt/venv/bin/python news_machine.py"
  }
}
