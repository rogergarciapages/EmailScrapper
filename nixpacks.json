{
  "providers": ["python"],
  "pkgs": [
    "chromium"
  ],
  "phases": {
    "setup": {
      "nixPkgs": ["python3", "pip", "chromium"]
    },
    "install": {
      "cmds": [
        "python -m venv /opt/venv",
        ". /opt/venv/bin/activate",
        "pip install -r requirements.txt",
        "playwright install chromium"
      ]
    }
  },
  "start": {
    "cmd": "python news_machine.py"
  }
}
